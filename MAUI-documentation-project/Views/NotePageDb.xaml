<?xml version="1.0" encoding="utf-8"?>
<base:BasePage 
    xmlns:base="clr-namespace:MAUI_documentation_project.Views.Base"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MAUI_documentation_project.ViewModels"
    x:DataType="vm:NotePageDbViewModel"
    x:Class="MAUI_documentation_project.Views.NotePageDb">
    <ContentPage.Content>
        <VerticalStackLayout 
            Spacing="10"
            Margin="5">
            <Editor 
                x:Name="TextEditor"
                Placeholder="Enter your note"
                Text="{Binding Text}"
                HeightRequest="100" />
            <Grid 
                ColumnDefinitions="*,*" 
                ColumnSpacing="4">
                <Button 
                    Text="Save"
                    Command="{Binding SaveCurrentNoteCommand}" />

                <Button 
                    Grid.Column="1"
                    Text="Delete"
                    Command="{Binding RemoveCurrentNoteCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ContentPage.Content>
</base:BasePage>